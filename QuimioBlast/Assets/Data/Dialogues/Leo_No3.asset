  m_Script: {fileID: 11500000, guid: 87be9cb2b2219d54ea59d2993fbc04db, type: 3}
  m_Name: Leo_No3
  m_EditorClassIdentifier: Assembly-CSharp-firstpass::DialogueNode
  speakerName: Leonardo
  dialogueText: "Sua estrutura de dados interna - o seu Invent\xE1rio - deve estar\
    \ pronta para gerenciar esses novos elementos. Vou inserir uma unidade de cada\
    \ uma dessas fun\xE7\xF5es no topo da sua lista de itens. Use-as com sabedoria,\
    \ pequeno aut\xF4mato. Lembre-se: no fim das contas, a morte \xE9 apenas um\
    \ comando free() na sua mem\xF3ria."
  choices:
  - choiceText: "Obrigado, L\xE9o. Vou utilizar estas fun\xE7\xF5es bem."
